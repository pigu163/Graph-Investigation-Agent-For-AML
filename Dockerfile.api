FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN pip install --no-cache-dir uv==0.13.5 && uv sync --locked --no-dev
ENV PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "graph_investigation_agent_for_aml.api:app", "--host", "0.0.0.0", "--port", "8000"]
